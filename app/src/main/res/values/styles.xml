<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TopRoundedCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 수정된 캘린더 스타일 -->
    <style name="CustomCalendarViewStyle" parent="Theme.AppCompat">
        <item name="colorAccent">#4C7EED</item> <!-- 선택된 날짜 색상 -->
        <item name="android:textColorPrimary">@android:color/black</item> <!-- 일반 텍스트 색상 -->
        <!-- 오늘 날짜 강조 비활성화 -->
        <item name="android:datePickerStyle">@style/CustomDatePickerStyle</item>
        <!-- 기본 선택 비활성화 관련 속성 -->
        <item name="android:selectedWeekBackgroundColor">@android:color/transparent</item>
        <item name="android:focusedMonthDateColor">@android:color/black</item>
        <item name="android:unfocusedMonthDateColor">@android:color/darker_gray</item>
        <item name="android:weekSeparatorLineColor">@android:color/transparent</item>
    </style>

    <style name="CustomDatePickerStyle" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">#FFFFFF</item>
        <item name="android:calendarTextColor">@android:color/black</item>
        <item name="android:dayOfWeekBackground">@android:color/transparent</item>
        <item name="android:yearListSelectorColor">#4C7EED</item>
  
    <!-- Login specific text styles -->
    <style name="LoginTextHeader">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/login_text_primary</item>
    </style>
    
    <style name="LoginTextSubheader">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/login_text_secondary</item>
    </style>
    
    <style name="LoginInputText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/login_text_primary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/login_input_background</item>
    </style>
    
    <style name="LoginButtonText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="LoginLinkText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/login_link_color</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>